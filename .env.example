# Notion — intégration interne partagée UNIQUEMENT sur « Éditions de veille »
# et « Accès — portail ». Jamais sur le registre des organisations.
NOTION_TOKEN=ntn_xxx
NOTION_BASE_EDITIONS=353cd0cf363843efa4a553ee658180be
NOTION_BASE_ACCES=7c57cc81312d4e23930fa9dc783f609c

# Jeton de vérification remis par Notion à l'abonnement au webhook.
NOTION_WEBHOOK_SECRET=

# Secret de signature des liens d'accès. Ne quitte jamais le portail.
# Générer avec : openssl rand -base64 48
ACCES_SECRET_HMAC=

# Adresse publique du portail, utilisée pour composer les liens envoyés.
# La charte graphique v1.0 porte signauxfaibles.io ; le CLAUDE.md porte
# signal-faible.fr, avec la réserve « ou équivalent retenu ». À trancher avant
# le premier envoi : c'est ce domaine qui apparaîtra dans les courriers.
PORTAIL_URL=https://signauxfaibles.io

# Compte de service Google Workspace, délégation à l'échelle du domaine
# limitée à la portée gmail.send.
#
# VOIE RECOMMANDÉE : coller ici le contenu ENTIER du fichier de clé JSON
# téléchargé depuis Google Cloud, accolades comprises, sur une seule ligne.
# Le format JSON échappe déjà les retours à la ligne de la clé privée : rien
# ne peut se perdre au collage, et c'est ce qui évite l'erreur
# « DECODER routines::unsupported ».
GOOGLE_COMPTE_SERVICE_JSON={"type":"service_account", ... }

# Voie de repli, si l'on préfère séparer. Plus fragile : la clé privée porte
# des retours à la ligne qu'une console d'hébergement mutile facilement.
# Laisser vide si GOOGLE_COMPTE_SERVICE_JSON est renseigné.
GOOGLE_COMPTE_SERVICE_EMAIL=
GOOGLE_COMPTE_SERVICE_CLE_PRIVEE=
GMAIL_EXPEDITEUR=acces@signauxfaibles.io
GMAIL_EXPEDITEUR_NOM=signauxfaibles
